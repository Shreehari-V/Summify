MONGODB_URI=mongodb://localhost:27017/summify
JWT_SECRET_KEY=YOUR_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Hugging Face Inference API for Whisper Speech-to-Text
# Obtain your token at https://huggingface.co/settings/tokens (Read permission)
HF_TOKEN=your_hugging_face_token_here
HF_WHISPER_MODEL=openai/whisper-large-v3-turbo
